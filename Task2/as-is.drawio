        <UserObject label="&lt;b&gt;Смешение ответственности&lt;/b&gt;:&lt;br&gt;- цена, промо, статусы, логистика, платежи;&lt;br&gt;- исторические ветвления по каналам и регионам;&lt;br&gt;- fallback-механизмы с неполной эквивалентностью;&lt;br&gt;- часть логики в коде, часть в Oracle, часть в конфигах." plantUmlId="note_56" plantUmlBaseStyle="shape=note;size=10;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;whiteSpace=wrap;align=left;spacingLeft=4;shadow=0;strokeWidth=1;fontColor=#000000;fontFamily=Verdana;html=1;" plantUmlBaseValue="&lt;b&gt;Смешение ответственности&lt;/b&gt;:&lt;br&gt;- цена, промо, статусы, логистика, платежи;&lt;br&gt;- исторические ветвления по каналам и регионам;&lt;br&gt;- fallback-механизмы с неполной эквивалентностью;&lt;br&gt;- часть логики в коде, часть в Oracle, часть в конфигах." id="1Lf__q6R_X952Ri9GaN6-502">
