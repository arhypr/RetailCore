        <UserObject label="Order Event Hub&#xa;канонические события заказа" plantUmlId="n_13" plantUmlBaseStyle="shape=cylinder3;direction=east;size=5;fillColor=#EAF4FF;strokeColor=#555555;fontSize=14;whiteSpace=wrap;shadow=0;strokeWidth=1;fontColor=#000000;fontFamily=Verdana;" plantUmlBaseValue="Order Event Hub&#xa;канонические события заказа" id="1Lf__q6R_X952Ri9GaN6-370">
          <mxCell parent="1Lf__q6R_X952Ri9GaN6-369" style="shape=cylinder3;direction=east;size=5;fillColor=#EAF4FF;strokeColor=#555555;fontSize=14;whiteSpace=wrap;shadow=0;strokeWidth=1;fontColor=#000000;fontFamily=Verdana;" vertex="1">
            <mxGeometry height="144.41860465116275" width="267.12493958700315" x="33.54035115890622" y="111.45348837209299" as="geometry" />
